<div class="col-12 col-md-6 col-lg-5">
    <div class="card text-dark shadow-sm h-100">
        <div class="card-body text-center">
            <h5 class="card-title fw-bold mb-3">Incomes</h5>
            <% if (incomes === null) { %>
            <p class="card-text text-muted fs-5">Not tracked yet</p>
            <% } else { %>
            <p class="card-text text-muted fs-4"><%= formatters.formatCurrencyILS(incomes) %></p>
            <% } %>
            <i class="bi bi-arrow-up-circle-fill fs-3 text-success"></i>
        </div>
    </div>
</div>
